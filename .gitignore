# [ Begin custom .gitignore . ]

# Patterns starting with a dot.
**/.*
!**/.git*

# The private environment file stays local. The example file is public.
**/.env
!**/.env.example

# The session outputs stay local.
outputs/

# VSCode custom configs.
**/.vscode/

# [ End custom .gitignore . ]
# [ Begin dsh-plugin-template .gitignore . ]
node_modules/
*.log
.DS_Store
# [ End dsh-plugin-template .gitignore . ]
