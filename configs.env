# The models of each provider. One line holds a comma-separated model list.
# The Hugging Face list is the tested set. The OpenAI list holds the models that serve the strict
# table of twenty candidates. The DeepSeek list is the pre-test set.

huggingface.models_to_use=deepseek-ai/DeepSeek-V4.1-Flash-1017, Qwen/Qwen3-Coder-Next, moonshotai/Kimi-K3.1-Pro, zai-org/GLM-5.2, XiaomiMiMo/MiMo-V2.6-Pro-RL, tencent/Hy4, ByteDance-Seed/UI-TARS-1.5-7B, MiniMaxAI/MiniMax-M3, meta-llama/Llama-4-Maverick-17B-128E-Instruct, google/gemma-4-31B-it
huggingface.edge_host=cdn-lfs.hf.co
huggingface.reasoning=disabled

deepseek.models_to_use=deepseek-flash

openai.models_to_use=gpt-4.1, gpt-4o, gpt-5.1, gpt-5.2, gpt-5.4
