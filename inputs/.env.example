openrouter.base_url=https://openrouter.ai/api/v1
openrouter.api_key=<Your API key.>
openrouter.models_to_use=google/gemini-4-neon:batch, openai/gpt-6.2-sol:batch, deepseek/deepseek-v4.1-flash-1017:batch, anthropic/claude-opus-5.5:batch, x-ai/grok-4.7:batch, qwen/qwen3.8-flash, z-ai/glm-5.3-flash:batch
openrouter.reasoning=disabled

huggingface.base_url=https://router.huggingface.co/v1
huggingface.api_key=<Your API key.>
huggingface.models_to_use=ByteDance-Seed/UI-TARS-1.5-7B, Qwen/Qwen3-Coder-Next, Qwen/Qwen3-VL-8B-Instruct, Qwen/Qwen3.6-35B-A3B, XiaomiMiMo/MiMo-V2.6-Flash-RL, XiaomiMiMo/MiMo-V2.6-Pro-RL, deepseek-ai/DeepSeek-V4-Pro-0813, deepseek-ai/DeepSeek-V4.1-Flash-1017, google/gemma-4-26B-A4B-it, google/gemma-4-31B-it, ibm-granite/granite-4.2-8b, inclusionAI/Ling-3.1-flash, meta-llama/Llama-4-Maverick-17B-128E-Instruct, moonshotai/Kimi-K3.1-Pro, tencent/Hy4, zai-org/GLM-5.2
huggingface.reasoning=disabled
# When a local network blocks the host of base_url, one open edge of the same provider can
# carry the request. Remove the hash sign and name the edge host of that network.
# huggingface.edge_host=cdn-lfs.hf.co

deepseek.base_url=https://api.deepseek.com
deepseek.api_key=<Your API key.>
deepseek.models_to_use=deepseek-flash
deepseek.reasoning=disabled
deepseek.thinking=disabled
