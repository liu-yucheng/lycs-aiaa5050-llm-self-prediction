{
  "schemaVersion": 1,
  "description": "Default provider definitions for the 2026 self-prediction experiment. Each provider uses an OpenAI-compatible chat completions endpoint. The environmentPrefix field names the section of the .env file that overrides the base URL, the model, and the API key.",
  "providers": [
    {
      "key": "deepseek",
      "label": "DeepSeek",
      "baseUrl": "https://api.deepseek.com/v1",
      "model": "deepseek-chat",
      "apiKeyEnvironmentVariable": "DEEPSEEK_API_KEY",
      "enabled": true,
      "environmentPrefix": "deepseek"
    },
    {
      "key": "qwen",
      "label": "Qwen",
      "baseUrl": "https://dashscope.aliyuncs.com/compatible-mode/v1",
      "model": "qwen-flash",
      "apiKeyEnvironmentVariable": "DASHSCOPE_API_KEY",
      "enabled": true,
      "environmentPrefix": "qwen"
    },
    {
      "key": "glm",
      "label": "GLM",
      "baseUrl": "https://open.bigmodel.cn/api/paas/v4",
      "model": "glm-4.5-flash",
      "apiKeyEnvironmentVariable": "ZHIPU_API_KEY",
      "enabled": true,
      "environmentPrefix": "zhipu"
    },
    {
      "key": "mock",
      "label": "Mock",
      "baseUrl": "mock://local",
      "model": "mock-flash",
      "apiKeyEnvironmentVariable": "",
      "enabled": false,
      "environmentPrefix": "mock"
    }
  ]
}
