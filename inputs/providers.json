{
  "schemaVersion": 1,
  "description": "Default provider definitions for the 2026 self-prediction experiment. The openrouter entry names one OpenAI-compatible endpoint and a model list. The plugin expands the list into one provider per model. The environmentPrefix field names the section of the .env file that overrides the base URL, the model list, and the API key.",
  "providers": [
    {
      "key": "openrouter",
      "label": "OpenRouter",
      "baseUrl": "https://openrouter.ai/api/v1",
      "model": "google/gemini-4-neon:batch",
      "models": [
        "google/gemini-4-neon:batch",
        "openai/gpt-6.2-sol:batch",
        "deepseek/deepseek-v4.1-flash-1017:batch",
        "anthropic/claude-opus-5.5:batch",
        "x-ai/grok-4.7:batch",
        "qwen/qwen3.8-flash",
        "z-ai/glm-5.3-flash:batch"
      ],
      "apiKeyEnvironmentVariable": "OPENROUTER_API_KEY",
      "enabled": true,
      "environmentPrefix": "openrouter",
      "topLogprobsCount": 20,
      "reasoning": "disabled"
    },
    {
      "key": "mock",
      "label": "Mock",
      "baseUrl": "mock://local",
      "model": "mock-flash",
      "apiKeyEnvironmentVariable": "",
      "enabled": false,
      "environmentPrefix": "mock"
    }
  ]
}
